#!/usr/bin/env bash
# One-shot verification entry point.
#
#   ./verify            # host: needs g++, python3 (+requirements), node/npm
#
# Runs, in order, failing fast with a non-zero exit code on any problem:
#   1. Build checks  - compile the exact C++ search engine, build the React app
#   2. Code tests    - unittest suite (spawns a real uvicorn server)
#   3. HTTP smoke    - health, the block-preemption counterexample, and the
#                      no-feasible-assignment boundary over real HTTP
#
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND="$ROOT/backend"
FRONTEND="$ROOT/frontend"
BIN="$BACKEND/app/bin/solver"
export SOLVER_BIN="$BIN"

# Prefer a project virtualenv if one exists (PEP 668 system Python otherwise
# refuses pip installs).
if [ -x "$ROOT/.venv/bin/python" ]; then
  PY="$ROOT/.venv/bin/python"
else
  PY="${PYTHON:-python3}"
fi

red()   { printf '\033[31m%s\033[0m\n' "$*"; }
green() { printf '\033[32m%s\033[0m\n' "$*"; }
step()  { printf '\n\033[1;36m== %s ==\033[0m\n' "$*"; }

fail=0
trap 'kill "${SRV_PID:-0}" 2>/dev/null || true' EXIT

# ---------------------------------------------------------------- 1. builds
step "1/3 build checks"

mkdir -p "$BACKEND/app/bin"
if g++ -O2 -std=c++17 -Wall -Wextra -o "$BIN" "$BACKEND/app/solver.cpp"; then
  green "  [ok] C++ solver compiled"
else
  red "  [fail] C++ solver build"; exit 1
fi

if [ -d "$FRONTEND/node_modules" ]; then
  npm --prefix "$FRONTEND" run build >/tmp/verify-vite.log 2>&1
else
  npm --prefix "$FRONTEND" --cache /tmp/npm-cache install --no-audit --no-fund \
      >/tmp/verify-npm.log 2>&1 \
    && npm --prefix "$FRONTEND" run build >/tmp/verify-vite.log 2>&1
fi
if [ $? -eq 0 ]; then
  green "  [ok] frontend production build"
  rm -rf "$BACKEND/app/static"
  cp -r "$FRONTEND/dist" "$BACKEND/app/static"
else
  red "  [fail] frontend build (see /tmp/verify-vite.log)"; exit 1
fi

# Python deps importable?
if "$PY" -c "import fastapi, uvicorn, pydantic" 2>/dev/null; then
  green "  [ok] python dependencies present"
else
  red "  [fail] install backend deps: pip install -r backend/requirements.txt"
  exit 1
fi

# ---------------------------------------------------------------- 2. tests
step "2/3 code tests"
if ! "$PY" -m unittest discover -s "$BACKEND/tests" -v; then
  red "  [fail] unit / API tests"; exit 1
fi
green "  [ok] all code tests passed"

# ---------------------------------------------------------------- 3. smoke
step "3/3 HTTP smoke (preemption counterexample + infeasible boundary)"

PORT="$("$PY" -c 'import socket;s=socket.socket();s.bind(("127.0.0.1",0));print(s.getsockname()[1]);s.close()')"
BASE="http://127.0.0.1:$PORT"

( cd "$BACKEND" && "$PY" -m uvicorn app.main:app \
    --host 127.0.0.1 --port "$PORT" >/tmp/verify-uvicorn.log 2>&1 ) &
SRV_PID=$!

for _ in $(seq 1 50); do
  curl -fsS "$BASE/health" >/dev/null 2>&1 && break
  sleep 0.2
done
if ! curl -fsS "$BASE/health" | grep -q '"ok"'; then
  red "  [fail] health check"; tail -20 /tmp/verify-uvicorn.log; exit 1
fi
green "  [ok] GET /health"

# 3a. preemption: global optimum max dev 11, naive grabbing gives 15.
read -r -d '' PREEMPT <<'JSON'
{"blocks":[
 {"id":"P","length":100},{"id":"Q","length":115},
 {"id":"X","length":40},{"id":"Y","length":39},
 {"id":"Z1","length":300},{"id":"Z2","length":301},
 {"id":"Z3","length":302},{"id":"Z4","length":303}],
 "targets":[{"target":90,"tolerance":11},{"target":100,"tolerance":15}]}
JSON

curl -fsS -X POST "$BASE/api/solve" -H 'Content-Type: application/json' \
        -d "$PREEMPT" -o /tmp/verify-preempt.json
"$PY" - <<'PY' || fail=1
import json
d = json.load(open("/tmp/verify-preempt.json"))
assert d["ok"], d
assert d["maxAbsDev"] == 11, d
assert d["canonical"] == [["X", "Y"], ["P"]], d["canonical"]
assert d["gaps"][0]["deviation"] == -11
assert d["gaps"][1]["deviation"] == 0
assert d["totalOptimal"] == "1"
dest = {x["id"]: x for x in d["destinations"]}
assert dest["P"]["kind"] == "fixed" and dest["P"]["gap"] == 1
assert dest["Q"]["kind"] == "always_unused"
print("  [ok] preemption counterexample over HTTP "
      "(global max dev 11 < greedy 15)")
PY

# 3b. infeasible boundary: each gap of 50±2 individually satisfiable, but only
# one block (B) is near 50, so two gaps cannot be disjointly served.
read -r -d '' INFEAS <<'JSON'
{"blocks":[
 {"id":"B","length":50},{"id":"T0","length":31},{"id":"T1","length":31},
 {"id":"T2","length":31},{"id":"T3","length":31},{"id":"T4","length":31},
 {"id":"T5","length":31},{"id":"T6","length":31}],
 "targets":[{"target":50,"tolerance":2},{"target":50,"tolerance":2}]}
JSON

CODE="$(curl -s -o /tmp/verify-infeas.json -w '%{http_code}' -X POST \
        "$BASE/api/solve" -H 'Content-Type: application/json' -d "$INFEAS")"
if [ "$CODE" = "422" ] && "$PY" -c '
import json; d=json.load(open("/tmp/verify-infeas.json"))
assert d["ok"] is False and d.get("infeasible") is True
print("  [ok] infeasible boundary over HTTP (422 infeasible, input echoed)")
'; then
  :
else
  red "  [fail] infeasible boundary (http=$CODE)"; cat /tmp/verify-infeas.json; fail=1
fi

# 3c. a validation error must not look like a solution.
read -r -d '' BAD <<'JSON'
{"blocks":[{"id":"A","length":1.5}],
 "targets":[{"target":10,"tolerance":1}]}
JSON
CODE="$(curl -s -o /tmp/verify-bad.json -w '%{http_code}' -X POST \
        "$BASE/api/solve" -H 'Content-Type: application/json' -d "$BAD")"
"$PY" - "$CODE" <<'PY' || fail=1
import json, sys
code = sys.argv[1]
d = json.load(open("/tmp/verify-bad.json"))
assert code == "422" and d["ok"] is False
assert any(e["field"] == "blocks[0].length" for e in d["errors"])
assert "totalOptimal" not in d
print("  [ok] non-integer rejected with field-level reason")
PY

if [ "$fail" -ne 0 ]; then red "\nVERIFY FAILED"; exit 1; fi
green "\nVERIFY PASSED (build + tests + HTTP smoke)"
exit 0
